[Unit]
Description=MundoVoxel - servidor de juego voxel (Windows/Linux, clientes Windows y Android)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/mundovoxel
ExecStart=/opt/mundovoxel/MundoVoxel.Server
Restart=on-failure
RestartSec=5
# Datos (mundos) y usuario sin privilegios
Environment=HOME=/var/lib/mundovoxel
User=mundovoxel
Group=mundovoxel

[Install]
WantedBy=multi-user.target