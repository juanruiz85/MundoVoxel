<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MundoVoxel.Client.App">
    <Application.Resources>
        <ResourceDictionary>

            <Color x:Key="Fondo">#10161f</Color>
            <Color x:Key="Superficie">#1b2430</Color>
            <Color x:Key="Acento">#4caf50</Color>
            <Color x:Key="AcentoClaro">#81c784</Color>
            <Color x:Key="Texto">#e8eef5</Color>
            <Color x:Key="TextoSuave">#9fb0c3</Color>
            <Color x:Key="Peligro">#e5534b</Color>

            <Style TargetType="Page">
                <Setter Property="BackgroundColor" Value="{StaticResource Fondo}" />
            </Style>

            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Acento}" />
                <Setter Property="TextColor" Value="#0b121a" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="HeightRequest" Value="48" />
                <Setter Property="Margin" Value="0,6" />
            </Style>

            <Style x:Key="BtnSecundario" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Superficie}" />
                <Setter Property="TextColor" Value="{StaticResource Texto}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="HeightRequest" Value="46" />
                <Setter Property="Margin" Value="0,5" />
            </Style>

            <Style x:Key="BtnPeligro" TargetType="Button" BasedOn="{StaticResource BtnSecundario}">
                <Setter Property="TextColor" Value="{StaticResource Peligro}" />
            </Style>

            <Style TargetType="Entry">
                <Setter Property="BackgroundColor" Value="{StaticResource Superficie}" />
                <Setter Property="TextColor" Value="{StaticResource Texto}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource TextoSuave}" />
                <Setter Property="HeightRequest" Value="46" />
                <Setter Property="FontSize" Value="15" />
            </Style>

            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource Texto}" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
