<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MundoVoxel.Client.Paginas.PaginaMenu"
             Title="MundoVoxel">
    <ScrollView>
        <VerticalStackLayout Padding="28,70,28,40" Spacing="8" MaximumWidthRequest="460" HorizontalOptions="Center">
            <Label x:Name="LblTitulo" FontSize="44" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{StaticResource AcentoClaro}" />
            <Label x:Name="LblSubtitulo" FontSize="15" HorizontalOptions="Center" TextColor="{StaticResource TextoSuave}" Margin="0,0,0,18" />

            <Label x:Name="LblNombre" Margin="0,8,0,0" />
            <Entry x:Name="EntNombre" ReturnType="Next" />
            <Label x:Name="LblIp" Margin="0,10,0,0" />
            <Grid ColumnDefinitions="*,112" ColumnSpacing="8">
                <Entry x:Name="EntIp" />
                <Entry x:Name="EntPuerto" Grid.Column="1" Keyboard="Numeric" />
            </Grid>

            <Button x:Name="BtnSolo" Clicked="OnJugarSolo" Margin="0,16,0,0" />
            <Button x:Name="BtnConectar" Style="{StaticResource BtnSecundario}" Clicked="OnConectar" />

            <Label x:Name="LblEstado" FontSize="13" TextColor="{StaticResource Peligro}" IsVisible="False" Margin="0,10,0,0" LineBreakMode="WordWrap" />

            <Label x:Name="LblControlesTitulo" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextoSuave}" Margin="0,28,0,0" />
            <Label x:Name="LblControles" FontSize="12" TextColor="{StaticResource TextoSuave}" LineBreakMode="WordWrap" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
