{
  // Ajustes de MundoVoxel (se leen al iniciar el servidor, junto al ejecutable).
  // Si borras el archivo o quitas una clave, se usa el valor por defecto.
  "ProbabilidadPlantonHoja": 0.10,   // probabilidad de que una hoja suelte un planton
  "ProbabilidadManzanaHoja": 0.06,   // probabilidad de que una hoja suelte una manzana
  "ProbabilidadPaloHoja": 0.12,      // probabilidad de que una hoja suelte un palo
  "LimitePitch": 1.55,               // limite de inclinacion vertical de la camara (radianes; 1.5708 = 90 grados, como Minecraft)
  "SensibilidadRaton": 1.0,          // sensibilidad por defecto del raton (multiplicador)
  "OxigenoMaximo": 15.0,             // segundos de oxigeno bajo el agua
  "DanioLavaPorSegundo": 4.0,        // dano por segundo al tocar lava
  "DanioAhogamientoPorSegundo": 2.0, // dano por segundo sin oxigeno
  // Cifrado opcional (TLS): con true el servidor cifra las conexiones. El
  // certificado autofirmado se genera solo la primera vez (%LOCALAPPDATA%\MundoVoxel\servidor.pfx).
  // En el cliente hay que marcar "Servidor cifrado (TLS)" antes de conectar.
  "Tls": false,

  // Clave de acceso del servidor (autenticacion basica): si no esta vacia, los
  // clientes deben escribirla en el menu para entrar (vacia = servidor abierto).
  "ClaveServidor": "",

  // Streaming por proximidad: cuantas regiones (de 64x64 columnas) alrededor del
  // jugador se mantienen cargadas. 1 = 3x3 = 192x192 columnas (por defecto).
  // Al alejarse, el servidor suelta las que salen del radio y el cliente las
  // descarga; si el jugador vuelve, se le mandan otra vez.
  "RadioRegiones": 1,

  // Cuentas por jugador (opcional). Con "CuentasObligatorias": true el servidor pide
  // usuario y clave antes de dejar entrar: el nombre deja de poder suplantarse (el
  // inventario y la propiedad de los mundos van por nombre). Con "RegistroAbierto":
  // true, la primera vez que alguien entra con un nombre nuevo se registra solo.
  // Las cuentas se guardan en "cuentas.json" (junto a este archivo); la clave nunca
  // se guarda, solo su hash PBKDF2-SHA256 con sal.
  "CuentasObligatorias": false,
  "RegistroAbierto": false,
  "CuentasArchivo": "cuentas.json"
}
